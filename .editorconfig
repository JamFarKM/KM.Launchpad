# Keeps editors, generated fixtures and both toolchains agreeing on the basics.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,css,json,yml,yaml,html}]
indent_size = 2

# Markdown uses trailing double-space as a hard break.
[*.md]
trim_trailing_whitespace = false
