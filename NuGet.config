<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone project: ignore any machine/user feeds (e.g. private TT-Package-Feed)
     and restore only from public nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
