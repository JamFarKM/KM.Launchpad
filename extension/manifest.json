{
  "manifest_version": 3,
  "name": "Pull requests in Launchpad",
  "version": "2.0.0",
  "description": "Offers a link to Pipeline Launchpad on Azure DevOps pull request pages.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules.js"
      ],
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "Pull requests in Launchpad"
  }
}
