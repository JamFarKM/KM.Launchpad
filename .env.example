# Copy to .env and adjust. docker-compose reads this file.

# Default Azure DevOps organization users connect to (they can override at login).
ADO_DEFAULT_ORG=BetagyDevOps

# Host port to expose the app on.
PORT=8080

# Key used to derive the Data Protection master key that encrypts stored PATs.
# Generate a long random value, e.g.  openssl rand -base64 48
# If unset, keys are persisted to the mounted data volume instead (fine for single-host).
DATAPROTECTION_KEY=
